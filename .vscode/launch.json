{
  "configurations": [
    {
      "name": "Launch nuxt dev",
      "request": "launch",
      "runtimeArgs": [
        "run",
        "--filter",
        "@bootstrap-vue-next/nuxt",
        "dev"
      ],
      "runtimeExecutable": "bun",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
    {
      "name": "Launch app dev",
      "request": "launch",
      "runtimeArgs": [
        "run",
        "--filter",
        "bootstrap-vue-next",
        "dev"
      ],
      "runtimeExecutable": "bun",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
    {
      "name": "Launch app unit test",
      "request": "launch",
      "runtimeArgs": [
        "run",
        "--filter",
        "bootstrap-vue-next",
        "test:unit"
      ],
      "runtimeExecutable": "bun",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
  ]
}