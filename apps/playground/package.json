    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.94.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "typescript": "^6.0.3",
    "vite": "catalog:",
