{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev --port 8000",
    "build-only": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitepress build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vitepress preview",
    "format": "vp fmt src/",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint . --fix --cache",
    "lint:oxlint": "vp lint . --fix",
    "test:lint:eslint": "eslint src tests",
    "test:lint:oxlint": "vp lint src tests",
    "test:lint": "run-s test:lint:eslint test:lint:oxlint",
    "test:unit": "vp test",
    "test:unit:ci": "vp test run",
    "test": "run-s test:lint test:unit",
    "test:lint:ci": "bun run test:lint",
    "test:ci": "run-s test:lint:ci test:unit:ci"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/logos": "^1.2.20",
    "@stackblitz/sdk": "^1.11.1",
    "@toycode/markdown-it-class": "^1.2.4",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.13.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "~15.0.0",
    "bootstrap": "^6.0.0-alpha.1",
    "bootstrap-vue-next": "workspace:^",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.94.0",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "markdown-it": "^15.0.3",
    "npm-run-all2": "^9.0.4",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "catalog:",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "^1.15.0",
    "vue": "3.5.45",
    "yaml": "^2.9.1",
    "vite-plus": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "*.{js,ts,mts,tsx,vue}": "vp fmt"
  }
}
