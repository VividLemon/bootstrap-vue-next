{
  "name": "bootstrap-vue-next",
  "displayName": "BootstrapVueNext",
  "description": "Seamless integration of Vue 3, Bootstrap 5, and TypeScript for modern, type-safe UI development",
  "version": "1.2.4",
  "license": "MIT",
  "type": "module",
  "main": "./dist/bootstrap-vue-next.mjs",
  "module": "./dist/bootstrap-vue-next.mjs",
  "types": "./dist/index.d.mts",
  "style": "./dist/bootstrap-vue-next.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/bootstrap-vue-next.mjs"
    },
    "./components": {
      "types": "./dist/components/index.d.mts",
      "default": "./dist/src/components/index.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.mts",
      "default": "./dist/src/components/*/index.mjs"
    },
    "./directives": {
      "types": "./dist/directives/index.d.mts",
      "default": "./dist/src/directives/index.mjs"
    },
    "./directives/*": {
      "types": "./dist/directives/*/index.d.mts",
      "default": "./dist/src/directives/*/index.mjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.mts",
      "default": "./dist/src/plugins/index.mjs"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*/index.d.mts",
      "default": "./dist/src/plugins/*/index.mjs"
    },
    "./composables": {
      "types": "./dist/composables/index.d.mts",
      "default": "./dist/src/composables/index.mjs"
    },
    "./composables/*": {
      "types": "./dist/composables/*/index.d.mts",
      "default": "./dist/src/composables/*/index.mjs"
    },
    "./resolvers": {
      "types": "./dist/resolvers/index.d.mts",
      "default": "./dist/src/resolvers/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "default": "./dist/src/utils/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "default": "./dist/src/types/index.mjs"
    },
    "./types/*": {
      "types": "./dist/types/*.d.mts"
    },
    "./dist/bootstrap-vue-next.css": "./dist/bootstrap-vue-next.css",
    "./src/styles/styles.scss": "./src/styles/styles.scss"
  },
  "files": [
    "dist",
    "src/**/*.scss"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "private": false,
  "scripts": {
    "dev": "vp dev --port 5174",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "build": "run-p type-check \"build-only {@}\" --",
    "publint": "publint",
    "format": "vp fmt src/",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint . --fix --cache",
    "lint:oxlint": "vp lint . --fix",
    "test:unit": "vp test",
    "test:coverage": "vp test --coverage",
    "test:lint:eslint": "eslint src",
    "test:lint:oxlint": "vp lint src",
    "test:lint": "run-s test:lint:eslint test:lint:oxlint",
    "test": "run-s test:lint test:unit",
    "test:lint:ci": "bun run test:lint",
    "test:unit:ci": "vp test run",
    "test:ci": "run-s test:lint:ci test:unit:ci"
  },
  "peerDependencies": {
    "@floating-ui/vue": "*",
    "@internationalized/date": "*",
    "@vueuse/core": "*",
    "@vueuse/integrations": "*",
    "bootstrap": "^6.0.0-alpha.1",
    "focus-trap": "*",
    "reka-ui": "*",
    "vue": "^3.5.13",
    "vue-router": "*"
  },
  "peerDependenciesMeta": {
    "@floating-ui/vue": {
      "optional": true
    },
    "@internationalized/date": {
      "optional": true
    },
    "@vueuse/core": {
      "optional": true
    },
    "@vueuse/integrations": {
      "optional": true
    },
    "focus-trap": {
      "optional": true
    },
    "reka-ui": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/vue": "^2.0.1",
    "@vueuse/core": "~15.0.0",
    "reka-ui": "^2.11.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/runtime-core": "3.5.45",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/shared": "^15.0.0",
    "bootstrap": "^6.0.0-alpha.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.94.0",
    "eslint-plugin-vue": "^10.12.1",
    "focus-trap": "^8.2.5",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "sass-embedded": "^1.108.2",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "catalog:",
    "vue": "3.5.45",
    "vue-tsc": "^3.3.14",
    "vite-plus": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bootstrap-vue-next/bootstrap-vue-next.git",
    "directory": "packages/bootstrap-vue-next"
  },
  "bugs": {
    "url": "https://github.com/bootstrap-vue-next/bootstrap-vue-next/issues"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/bootstrap-vue-next"
  },
  "homepage": "https://github.com/bootstrap-vue-next/bootstrap-vue-next",
  "keywords": [
    "bootstrap-vue-next",
    "bootstrap-vue-3",
    "bootstrap",
    "vue",
    "nuxt",
    "typescript",
    "components",
    "a11y",
    "css",
    "scss",
    "ssr",
    "accordion",
    "alert",
    "avatar",
    "badge",
    "breadcrumb",
    "button",
    "card",
    "carousel",
    "checkbox",
    "collapse",
    "column",
    "container",
    "datepicker",
    "dropdown",
    "file input",
    "form",
    "input",
    "input group",
    "link",
    "list group",
    "modal",
    "nav",
    "navbar",
    "offcanvas",
    "overlay",
    "pagination",
    "placeholder",
    "popover",
    "progress",
    "radio",
    "rating",
    "row",
    "select",
    "skeleton",
    "spinbutton",
    "spinner",
    "table",
    "tabs",
    "tags",
    "textarea",
    "timepicker",
    "toast",
    "tooltip"
  ],
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "!(CHANGELOG)*.md": "prettier --write --ignore-unknown",
    "!(*md)": "prettier --write --ignore-unknown"
  }
}
